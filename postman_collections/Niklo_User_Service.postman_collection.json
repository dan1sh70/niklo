                    "name": "Create Auth Otp Send",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/auth/otp/send",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "otp",
                                "send"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
