{
    "info": {
        "name": "Niklo Payment Service",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "your_jwt_token_here",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Payment",
            "item": [
                {
                    "name": "payment_methods_screen",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "orders"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "Razorpay Webhook (server-to-server)",
                    "request": {
                        "method": "POST",
