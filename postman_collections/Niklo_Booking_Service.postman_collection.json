{
    "info": {
        "name": "Niklo Booking Service",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "your_jwt_token_here",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Bookings",
            "item": [
                {
                    "name": "package_traveler_details_screen",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "Razorpay checkout success handler",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings/:id/confirm-payment",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings",
                                ":id",
                                "confirm-payment"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "bookings_screen",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings/my-bookings",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings",
                                "my-bookings"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Update Bookings Status",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings/:id/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings",
                                ":id",
                                "status"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "Create Bookings Cancel",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings/:id/cancel",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings",
                                ":id",
                                "cancel"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "Booking details screen",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings",
                                ":id"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Create Bookings B8F3A2C1-Uuid Confirm-Payment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/bookings/b8f3a2c1-uuid/confirm-payment",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "bookings",
                                "b8f3a2c1-uuid",
                                "confirm-payment"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"example\": \"data\"\n}"
                        }
                    },
                    "response": []
                }
            ]
        }
    ]
}