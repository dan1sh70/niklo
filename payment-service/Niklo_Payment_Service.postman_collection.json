{
    "info": {
        "name": "Niklo Payment Service",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "your_jwt_token_here",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "App",
            "item": [
                {
                    "name": "getHello",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                ""
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Payments",
            "item": [
                {
                    "name": "createOrder",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "orders"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 0,\n    \"currency\": \"string_value\",\n    \"booking_id\": \"string_value\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "getPaymentDetails",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/orders/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "orders",
                                ":id"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "razorpayWebhook",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/webhook/razorpay",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "webhook",
                                "razorpay"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Wallet",
            "item": [
                {
                    "name": "getBalance",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/wallet/balance",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "wallet",
                                "balance"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "initiateTopUp",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/wallet/topup",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "wallet",
                                "topup"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 0,\n    \"description\": \"string_value\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "confirmTopUp",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/wallet/confirm",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "wallet",
                                "confirm"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"razorpay_order_id\": \"string_value\",\n    \"razorpay_payment_id\": \"string_value\",\n    \"razorpay_signature\": \"string_value\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "payWithWallet",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/wallet/pay",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "wallet",
                                "pay"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 0,\n    \"booking_id\": \"string_value\",\n    \"booking_type\": \"string_value\",\n    \"description\": \"string_value\"\n}"
                        }
                    },
                    "response": []
                },
                {
                    "name": "getTransactions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/wallet/transactions",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "wallet",
                                "transactions"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Webhooks",
            "item": [
                {
                    "name": "handleRazorpayWebhook",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payment/webhook/razorpay",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payment",
                                "webhook",
                                "razorpay"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ]
}